# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this file to .env and fill in your real values.
# This file is SAFE to commit. The real .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
DB_PASSWORD=your_db_password_here

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars

# (Optional) Override DB connection — defaults to localhost:5432/ecom
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecom
# SPRING_DATASOURCE_USERNAME=postgres

# (Optional) Override Redis — defaults to localhost:6379
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
